# Raíz del proyecto (por defecto se detecta subiendo hasta encontrar CLAUDE.md + marcas/)
CS_REPO_ROOT=
# Binario de Claude Code. Pon la ruta absoluta (`which claude`) si la app no hereda tu PATH.
CLAUDE_BIN=claude
# Token de Apify (alternativa: Ajustes → se guarda en data/secrets.json, ignorado por git)
APIFY_TOKEN=
# Git sync
CS_GIT_REMOTO=origin
CS_GIT_RAMA=main
CS_SYNC_AUTO=1
# Puerto del panel
PORT=3030
# real | mock (mock reproduce un stream grabado sin lanzar claude; útil para desarrollar la UI)
CS_RUNNER=real
# ── Acceso web (v2.5) ── iguales en las dos Macs; ver docs/setup-mac.md
# Secreto de sesión (openssl rand -hex 32). Sin AUTH_SECRET + cliente de Google la app no sirve nada.
AUTH_SECRET=
# Cliente OAuth «Aplicación web» de Google Cloud
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# URL pública canónica (la puerta de Cloudflare)
AUTH_URL=https://competitorseeker.luislandadentsu.workers.dev
# Primer admin (entra siempre como admin)
CS_ADMIN_EMAIL=
# off = sin login, SOLO para la copia de desarrollo en localhost (lo que llega por Cloudflare se rechaza)
CS_AUTH=on
