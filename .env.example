# Raíz del proyecto (por defecto se detecta subiendo hasta encontrar CLAUDE.md + marcas/)
CS_REPO_ROOT=
# Binario de Claude Code. Pon la ruta absoluta (`which claude`) si la app no hereda tu PATH.
CLAUDE_BIN=claude
# Token de Apify (alternativa: Ajustes → se guarda en data/secrets.json, ignorado por git)
APIFY_TOKEN=
# Git sync
CS_GIT_REMOTO=origin
CS_GIT_RAMA=main
CS_SYNC_AUTO=1
# Puerto del panel
PORT=3030
# real | mock (mock reproduce un stream grabado sin lanzar claude; útil para desarrollar la UI)
CS_RUNNER=real
